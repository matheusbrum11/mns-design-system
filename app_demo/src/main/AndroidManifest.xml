<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      O catálogo demonstra MnsAsyncImage carregando de uma URL real. A
      biblioteca não declara esta permissão: quem decide se o app acessa a rede
      é o app, não o design system.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MnsDemo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MnsDemo"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Permite ao :benchmark medir cold start de uma tela específica. -->
        <profileable android:shell="true" tools:targetApi="29"
            xmlns:tools="http://schemas.android.com/tools" />
    </application>

</manifest>
